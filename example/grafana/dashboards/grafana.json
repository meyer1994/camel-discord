          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(event_time, $__interval),\n  channel_name AS metric,\n  COUNT(*) AS value\nFROM twitch_event_chat\nWHERE $__timeFilter(event_time)\n  AND channel_name IN (${channel:sqlstring})\nGROUP BY 1, 2\nORDER BY 1",
