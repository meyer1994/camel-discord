    {
      "id": 15,
      "type": "barchart",
      "title": "Subscriber Message Share by Channel",
      "description": "Percentage of messages where subscriber_months is greater than zero.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GnYlRd" }, "decimals": 1, "mappings": [], "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "options": {
