          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  channel_name AS \"Channel\",\n  ROUND(100.0 * COUNT(*) FILTER (WHERE subscriber_months > 0) / NULLIF(COUNT(*), 0), 1) AS \"Subscriber %\"\nFROM twitch_event_chat\nWHERE $__timeFilter(event_time)\n  AND channel_name IN (${channel:sqlstring})\nGROUP BY channel_name\nORDER BY \"Subscriber %\" DESC",
