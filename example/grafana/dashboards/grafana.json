      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH first_seen AS (\n  SELECT user_id, MIN(event_time) AS first_message\n  FROM twitch_event_chat\n  WHERE user_id IS NOT NULL\n  GROUP BY user_id\n), daily AS (\n  SELECT\n    DATE_TRUNC('day', event_time) AS time,\n    COUNT(DISTINCT e.user_id) FILTER (WHERE DATE_TRUNC('day', f.first_message) = DATE_TRUNC('day', e.event_time)) AS new_chatters,\n    COUNT(DISTINCT e.user_id) FILTER (WHERE DATE_TRUNC('day', f.first_message) < DATE_TRUNC('day', e.event_time)) AS returning_chatters\n  FROM twitch_event_chat e\n  JOIN first_seen f USING (user_id)\n  WHERE $__timeFilter(event_time)\n    AND channel_name IN (${channel:sqlstring})\n  GROUP BY 1\n)\nSELECT time, 'New' AS metric, new_chatters AS value FROM daily\nUNION ALL\nSELECT time, 'Returning' AS metric, returning_chatters AS value FROM daily\nORDER BY time, metric",
          "refId": "A"
        }
      ]
    },
