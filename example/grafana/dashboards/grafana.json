      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH chatter_counts AS (\n  SELECT user_id, COUNT(*) AS messages\n  FROM twitch_event_chat\n  WHERE $__timeFilter(event_time)\n    AND channel_name IN (${channel:sqlstring})\n  GROUP BY user_id\n)\nSELECT\n  CASE\n    WHEN messages = 1 THEN '1'\n    WHEN messages <= 5 THEN '2-5'\n    WHEN messages <= 10 THEN '6-10'\n    WHEN messages <= 25 THEN '11-25'\n    WHEN messages <= 50 THEN '26-50'\n    WHEN messages <= 100 THEN '51-100'\n    ELSE '100+'\n  END AS \"Messages\",\n  COUNT(*) AS \"Chatters\"\nFROM chatter_counts\nGROUP BY 1\nORDER BY MIN(messages)",
          "refId": "A"
        }
      ]
