          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH hourly AS (\n  SELECT channel_name, DATE_TRUNC('hour', event_time) AS hour, COUNT(*) AS messages\n  FROM twitch_event_chat\n  WHERE $__timeFilter(event_time)\n    AND channel_name IN (${channel:sqlstring})\n  GROUP BY channel_name, hour\n), ranked AS (\n  SELECT *, ROW_NUMBER() OVER (PARTITION BY channel_name ORDER BY messages DESC, hour DESC) AS rank\n  FROM hourly\n)\nSELECT channel_name AS \"Channel\", messages AS \"Peak messages\"\nFROM ranked\nWHERE rank = 1\nORDER BY \"Peak messages\" DESC",
          "refId": "A"
        }
