      "id": 25,
      "type": "timeseries",
      "title": "New vs Returning Chatters",
      "description": "New means the chatter's first-ever stored message occurred on that day.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 78 },
      "fieldConfig": {
