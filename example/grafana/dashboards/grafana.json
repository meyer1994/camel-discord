    {
      "id": 7,
      "type": "barchart",
      "title": "Weekly Routine — Average Messages per Hour",
      "description": "Average hourly messages for each weekday. Timezone is controlled by the dashboard variable.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0,
        "barWidth": 0.92,
        "fullHighlight": false,
        "groupWidth": 0.72,
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "auto",
        "showValue": "never",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH hourly AS (\n  SELECT\n    EXTRACT(ISODOW FROM event_time AT TIME ZONE '${timezone}')::int AS dow,\n    EXTRACT(HOUR FROM event_time AT TIME ZONE '${timezone}')::int AS hour,\n    DATE_TRUNC('hour', event_time AT TIME ZONE '${timezone}') AS hour_start,\n    COUNT(*)::numeric AS messages\n  FROM twitch_event_chat\n  WHERE $__timeFilter(event_time)\n    AND channel_name IN (${channel:sqlstring})\n  GROUP BY 1, 2, 3\n), routine AS (\n  SELECT dow, hour, AVG(messages) AS avg_messages\n  FROM hourly\n  GROUP BY dow, hour\n), hours AS (\n  SELECT GENERATE_SERIES(0, 23) AS hour\n)\nSELECT\n  LPAD(hours.hour::text, 2, '0') || ':00' AS \"Hour\",\n  COALESCE(MAX(avg_messages) FILTER (WHERE dow = 1), 0) AS \"Mon\",\n  COALESCE(MAX(avg_messages) FILTER (WHERE dow = 2), 0) AS \"Tue\",\n  COALESCE(MAX(avg_messages) FILTER (WHERE dow = 3), 0) AS \"Wed\",\n  COALESCE(MAX(avg_messages) FILTER (WHERE dow = 4), 0) AS \"Thu\",\n  COALESCE(MAX(avg_messages) FILTER (WHERE dow = 5), 0) AS \"Fri\",\n  COALESCE(MAX(avg_messages) FILTER (WHERE dow = 6), 0) AS \"Sat\",\n  COALESCE(MAX(avg_messages) FILTER (WHERE dow = 7), 0) AS \"Sun\"\nFROM hours\nLEFT JOIN routine USING (hour)\nGROUP BY hours.hour\nORDER BY hours.hour",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Channel Weekly Routine",
      "description": "Average messages per hour laid over a synthetic Monday–Sunday week, one series per channel.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 7,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH hourly AS (\n  SELECT\n    channel_name,\n    EXTRACT(ISODOW FROM event_time AT TIME ZONE '${timezone}')::int AS dow,\n    EXTRACT(HOUR FROM event_time AT TIME ZONE '${timezone}')::int AS hour,\n    DATE_TRUNC('hour', event_time AT TIME ZONE '${timezone}') AS hour_start,\n    COUNT(*)::numeric AS messages\n  FROM twitch_event_chat\n  WHERE $__timeFilter(event_time)\n    AND channel_name IN (${channel:sqlstring})\n  GROUP BY 1, 2, 3, 4\n), routine AS (\n  SELECT channel_name, dow, hour, AVG(messages) AS avg_messages\n  FROM hourly\n  GROUP BY channel_name, dow, hour\n)\nSELECT\n  TIMESTAMP '2024-01-01 00:00:00' + ((dow - 1) * INTERVAL '1 day') + (hour * INTERVAL '1 hour') AS time,\n  channel_name AS metric,\n  avg_messages AS value\nFROM routine\nORDER BY time, metric",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Messages by Weekday",
