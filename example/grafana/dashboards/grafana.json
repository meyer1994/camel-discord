      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  LPAD(EXTRACT(HOUR FROM event_time AT TIME ZONE '${timezone}')::int::text, 2, '0') || ':00' AS \"Hour\",\n  COUNT(*) AS \"Messages\"\nFROM twitch_event_chat\nWHERE $__timeFilter(event_time)\n  AND channel_name IN (${channel:sqlstring})\nGROUP BY EXTRACT(HOUR FROM event_time AT TIME ZONE '${timezone}')\nORDER BY EXTRACT(HOUR FROM event_time AT TIME ZONE '${timezone}')",
          "refId": "A"
