        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  TO_CHAR(DATE '2024-01-01' + (EXTRACT(ISODOW FROM event_time AT TIME ZONE '${timezone}')::int - 1), 'Dy') AS \"Weekday\",\n  COUNT(*) AS \"Messages\"\nFROM twitch_event_chat\nWHERE $__timeFilter(event_time)\n  AND channel_name IN (${channel:sqlstring})\nGROUP BY EXTRACT(ISODOW FROM event_time AT TIME ZONE '${timezone}')\nORDER BY EXTRACT(ISODOW FROM event_time AT TIME ZONE '${timezone}')",
          "refId": "A"
